---
import BaseLayout from "../layouts/BaseLayout.astro";

const skillGroups = [
  { cat: "Mobile & Architecture", items: "SwiftUI, Swift, UIKit, Swift Concurrency, Combine, Clean Architecture, MVVM, Dependency Injection, Modular Architecture, Objective-C, REST/JSON, Swift Package Manager, CocoaPods" },
  { cat: "State & Data", items: "SwiftData, Core Data, real-time data streaming, offline reliability, complex state management" },
  { cat: "AI & Agentic Systems", items: "Claude Code, MCP (Model Context Protocol), multi-agent orchestration, agentic pipeline design, LLM-assisted workflows, Core ML, on-device inference" },
  { cat: "Performance & Reliability", items: "Instruments, crash-free optimization, cold start reduction, Crashlytics, VoiceOver, Charles Proxy" },
  { cat: "DevOps & Quality", items: "CI/CD (Fastlane, Jenkins, Bitrise), TestFlight, Firebase, TDD, XCUITest, App Store Connect" },
  { cat: "Leadership", items: "Architectural decision-making, team management, mentoring, roadmap & strategy, cross-functional alignment, agile delivery" },
];
---
<BaseLayout title="About Me" description="12+ years building production iOS software. About me, how I work, and how to reach me." ogImage="/og/about.png">
  <section class="head">
    <h1 class="spring-in">Twelve years, one thread</h1>
    <div class="writeup fade-in" style="animation-delay:.2s">
      <p>I've spent 12+ years building mobile software that has to actually work: real users, real regulatory constraints, real money and health data on the line. That thread runs from the Vanguard app in 2012, through leading the ten-engineer team behind Fiserv's CardValet, to myMedidata, a HIPAA-regulated clinical trial app supporting 11 million participants. These days I'm building pragma, an 8-agent iOS development pipeline, and FinanceTracker, a production SwiftUI and SwiftData app it built almost entirely on its own.</p>
      <p>Outside of work, most of my time goes to my family, chasing my kid around and cooking something for dinner most nights. The rest goes into a home lab I'm probably too invested in: a NAS, a few Raspberry Pis, Home Assistant running the house, AdGuard keeping the network in check. Debugging a stubborn smart plug integration at 11pm scratches the same itch as debugging a CSV import race condition.</p>
      <p>I hold an M.S. in Computer Science from George Mason University and a B.E. in Information Technology from Ramrao Adik Institute of Technology, University of Mumbai. If any of this resonates, reach me at <a href="mailto:akshaypimprikar@gmail.com">akshaypimprikar@gmail.com</a>.</p>
    </div>
  </section>

  <section class="skills fade-in" style="animation-delay:.3s">
    <h2 class="section-headline">Technical foundation</h2>
    <div class="skill-groups">
      {skillGroups.map((g) => (
        <div class="skill-row">
          <div class="cat">{g.cat}</div>
          <p class="items">{g.items}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .head, .skills{padding:0 6vw; max-width:920px; margin:0 auto;}
  .head{padding-top:9vh;}
  h1{font-size:clamp(32px,5vw,52px); font-weight:600; letter-spacing:-.02em; margin:14px 0 0;}

  .writeup{display:flex; flex-direction:column; gap:16px; max-width:560px; margin:24px 0 0;}
  .writeup p{font-size:15px; color:var(--dim); line-height:1.75; margin:0;}
  .writeup a{color:var(--accent); text-decoration:none;}
  .writeup a:hover{text-decoration:underline;}

  .skills{margin-top:9vh; padding-bottom:10vh;}
  .section-headline{font-size:20px; font-weight:600; letter-spacing:-.01em; color:var(--ink); margin:0 0 18px;}
  .skill-groups{display:flex; flex-direction:column; gap:12px;}
  .skill-row{display:grid; grid-template-columns:170px 1fr; gap:22px; padding:6px 0;}
  .skill-row .cat{font-size:13px; color:var(--dim); font-weight:600; padding-top:1px;}
  .skill-row .items{margin:0; font-size:13px; color:var(--ink); line-height:1.65;}

  @media (max-width: 560px){
    .skill-row{grid-template-columns:1fr; gap:4px;}
  }
</style>
