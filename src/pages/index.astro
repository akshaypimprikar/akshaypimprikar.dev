---
import BaseLayout from "../layouts/BaseLayout.astro";

const apps = [
  { name: "myMedidata", co: "Medidata Solutions", stat: "4.7★ · 11M participants", note: "Clinical trial platform, HIPAA-regulated, 1M monthly active users.", icon: "/icons/mymedidata.webp", url: "https://apps.apple.com/us/app/mymedidata/id6443781776", category: "Healthcare" },
  { name: "CardValet", co: "Fiserv", stat: "5M users · 1,000+ institutions", note: "Consumer fintech app; redesigned it as an Analyst, then led the 10-engineer team as Lead SDE.", icon: "/icons/cardvalet.webp", url: "https://apps.apple.com/us/app/cardvalet/id849898083", category: "Fintech" },
  { name: "WW", co: "Weight Watchers", stat: "4.8★ · 4.6M users", note: "UI/UX improvements and HealthKit integration during peak growth.", icon: "/icons/ww.webp", url: "https://apps.apple.com/us/app/weightwatchers-program/id331308914", category: "Consumer & Media" },
  { name: "Miami HEAT Mobile", co: "SapientNitro (client: Miami Heat)", stat: "Games, stats, in-arena wallet", note: "Built while at SapientNitro: game tracking, statistics, and an in-app wallet for the Arena.", icon: "/icons/miamiheat.webp", url: "https://apps.apple.com/us/app/miami-heat-mobile/id497407923", category: "Sports" },
  { name: "Paramount", co: "Viacom", stat: "Best New App — Entertainment", note: "Built the first version in 2014, when it shipped as Spike TV, later rebranded Paramount Network then Paramount+. Same App Store listing, long since rebuilt by other teams.", icon: "/icons/paramount.webp", url: "https://apps.apple.com/us/app/paramount/id530168168", category: "Consumer & Media" },
  { name: "CVS", co: "CVS Caremark", stat: "ExtraCare feature", note: "Delivered the ExtraCare feature: data persistence for rewards and coupons.", icon: "/icons/cvs.webp", url: "https://apps.apple.com/us/app/cvs/id602716057", category: "Healthcare" },
  { name: "NYC 311", co: "NYC Dept. of IT & Telecom", stat: "+35% engagement", note: "Official app for non-emergency city services.", icon: "/icons/nyc311.webp", url: "https://apps.apple.com/us/app/nyc-311/id324897619", category: "Consumer & Media" },
  { name: "Vanguard", co: "The Vanguard Group", stat: "Real-time financial data", note: "Created the Markets Section, displaying real-time financial data.", icon: "/icons/vanguard.webp", url: "https://apps.apple.com/us/app/vanguard-save-invest-retire/id335186209", category: "Fintech" },
];

const categoryOrder = ["Fintech", "Healthcare", "Consumer & Media", "Sports"];
const groups = categoryOrder
  .map((category) => ({ category, items: apps.filter((a) => a.category === category) }))
  .filter((g) => g.items.length > 0);
---
<BaseLayout title="Home">
  <section class="hero">
    <h1 class="spring-in">Akshay Pimprikar</h1>
    <p class="role fade-in" style="animation-delay:.3s">
      Lead iOS Engineer with 12+ years building and scaling production software for 1M–20M users
      across fintech, healthcare, and consumer — currently building an autonomous agentic pipeline
      that ships real software end to end.
    </p>
    <div class="hero-ctas fade-in" style="animation-delay:.42s">
      <a class="resume-cta" href="/Akshay-Pimprikar-Resume.pdf" target="_blank" rel="noopener">
        Download resume →
      </a>
      <a class="about-cta" href="/about">
        About me →
      </a>
    </div>
  </section>

  <section class="cases fade-in" style="animation-delay:.5s">
    <h2 class="section-headline">Currently working on</h2>
    <a class="case glass-card interactive" href="/work/pragma">
      <img class="case-thumb" src="/case-thumbs/pragma-card.webp" alt="pragma's 8-agent workflow running" loading="lazy" width="368" height="460" />
      <h3>pragma — the agentic pipeline</h3>
      <p>An 8-agent iOS development pipeline: spec → plan → feature → gates → review → test → bugfix → release. Two of eight stages need human approval; the rest run autonomously until merge.</p>
      <div class="read-more">Read more →</div>
    </a>
    <a class="case glass-card interactive" href="/work/financetracker">
      <img class="case-thumb" src="/case-thumbs/financetracker-dashboard.jpg" alt="FinanceTracker dashboard running on iPhone" loading="lazy" width="368" height="460" />
      <h3>FinanceTracker — built by the pipeline</h3>
      <p>A production SwiftUI + SwiftData app: MVVM + Repository architecture, @ModelActor CSV import, VersionedSchema migrations, structured MCP build diagnostics.</p>
      <div class="read-more">Read more →</div>
    </a>
  </section>

  <section class="apps-intro fade-in" style="animation-delay:.9s">
    <h2 class="section-headline">Shipped apps</h2>
    <p class="apps-sub">Eight production apps across fintech, healthcare, consumer, and sports — shipped and maintained over 12+ years. Links go to each app's real App Store page.</p>
    <nav class="jump-nav" aria-label="Jump to app category">
      {groups.map((group) => (
        <a href={`#${group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{group.category}</a>
      ))}
    </nav>
  </section>

  {groups.map((group, gi) => (
    <section class="group" id={group.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}>
      <h3 class="group-headline fade-in" style={`animation-delay:${1.0 + gi * 0.1}s`}>{group.category}</h3>
      <div class="grid">
        {group.items.map((a, i) => {
          const Tag = a.url ? "a" : "div";
          return (
            <Tag
              class={`app glass-card fade-in ${a.url ? "linked interactive" : ""}`}
              style={`animation-delay:${1.1 + gi * 0.1 + i * 0.06}s`}
              {...(a.url ? { href: a.url, target: "_blank", rel: "noopener" } : {})}
            >
              {a.icon ? (
                <>
                  <img
                    class="icon-img"
                    src={a.icon}
                    alt={`${a.name} app icon`}
                    width="44"
                    height="44"
                    loading="lazy"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                  />
                  <div class="icon icon-fallback" aria-hidden="true">{a.name.slice(0, 2).toUpperCase()}</div>
                </>
              ) : (
                <div class="icon" aria-hidden="true">{a.name.slice(0, 2).toUpperCase()}</div>
              )}
              <div class="name">{a.name}</div>
              <div class="co">{a.co}</div>
              <div class="stat">{a.stat}</div>
              <p>{a.note}</p>
              <div class={`link ${a.url ? "" : "pending"}`}>{a.url ? "View on the App Store →" : "No longer available"}</div>
            </Tag>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .hero, .cases, .apps-intro, .group{padding:0 6vw; max-width:1180px; margin:0 auto;}
  .hero{padding-top:9vh;}
  h1{font-size:clamp(40px,6vw,74px); font-weight:600; letter-spacing:-.02em; line-height:1.02; margin:14px 0 0;}
  .role{font-size:15px; color:var(--dim); font-weight:400; max-width:560px; margin:20px 0 0; line-height:1.5;}
  .hero-ctas{display:flex; flex-wrap:wrap; gap:12px; margin-top:26px;}
  .resume-cta{display:inline-block; padding:11px 20px; border-radius:8px;
    background:var(--accent); color:var(--bg); font-size:13px; font-weight:600; text-decoration:none;
    transition:transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s ease;}
  .resume-cta:hover{transform:translateY(-1px); box-shadow:0 6px 20px rgba(201,161,90,.25);}
  .about-cta{display:inline-block; padding:11px 20px; border-radius:8px; border:1px solid var(--line);
    color:var(--ink); font-size:13px; font-weight:600; text-decoration:none;
    transition:border-color .25s ease, transform .25s cubic-bezier(.16,1,.3,1);}
  .about-cta:hover{border-color:var(--accent); transform:translateY(-1px);}

  .cases{margin-top:9vh; display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:start; position:relative;}
  .section-headline{grid-column:1 / -1; font-size:20px; font-weight:600; letter-spacing:-.01em; color:var(--ink); margin:0 0 6px;}
  .case{padding:0 0 24px; text-decoration:none; color:inherit; display:block; overflow:hidden;
    background:linear-gradient(155deg, rgba(255,255,255,.045), rgba(255,255,255,.015));}
  .case-thumb{width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; object-position:top; display:block; margin:0 0 20px; border-bottom:1px solid var(--line);}
  .case h3{margin:0 26px 8px; font-size:16px; font-weight:600; letter-spacing:-.01em;}
  .case p{margin:0 26px; font-size:13px; color:var(--dim); line-height:1.6;}
  .case .read-more{margin:14px 26px 0; font-size:13px; color:var(--dim);}
  .case:hover .read-more{color:var(--accent);}

  .apps-intro{margin-top:64px;}
  .apps-sub{font-size:15px; color:var(--dim); max-width:560px; margin:0; line-height:1.6;}
  .jump-nav{display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:18px;}
  .jump-nav a{font-size:12px; color:var(--dim); text-decoration:none; border-bottom:1px solid var(--line); padding-bottom:2px;}
  .jump-nav a:hover{color:var(--ink); border-color:var(--accent);}

  .group{margin-top:6vh;}
  .group:last-of-type{padding-bottom:10vh;}
  .group-headline{font-size:16px; font-weight:600; letter-spacing:-.01em; color:var(--ink); margin:0 0 16px;}
  .grid{display:grid; grid-template-columns:repeat(3,1fr); gap:16px;}
  .app{padding:24px 22px 20px; display:block; text-decoration:none; color:inherit;}
  .app.linked .link{color:var(--accent);}
  .app.linked:hover .link{text-decoration:underline;}
  .icon{width:44px; height:44px; border-radius:11px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, rgba(201,161,90,.35), rgba(120,140,255,.18));
    font-size:16px; font-weight:700; color:var(--ink); margin-bottom:14px;}
  .icon-fallback{display:none;}
  .icon-img{width:44px; height:44px; aspect-ratio:1/1; object-fit:cover; border-radius:11px; display:block; margin-bottom:14px;
    box-shadow:0 2px 10px rgba(0,0,0,.35);}
  .name{font-size:16px; font-weight:600;}
  .co{font-size:13px; color:var(--dim); margin-top:2px;}
  .stat{font-size:13px; color:var(--accent); margin-top:10px; font-weight:600;}
  .app p{font-size:13px; color:var(--dim); line-height:1.55; margin:8px 0 0;}
  .link{margin-top:14px; font-size:11px; letter-spacing:.03em; transition:color .25s ease;}
  .link.pending{color:var(--dim);}

  @media (max-width: 900px){
    .cases{grid-template-columns:1fr;}
    .grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width: 560px){
    .grid{grid-template-columns:1fr;}
  }
</style>
