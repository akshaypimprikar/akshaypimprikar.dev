---
import BaseLayout from "../layouts/BaseLayout.astro";

const skillGroups = [
  { cat: "Mobile & Architecture", items: "SwiftUI, Swift, UIKit, Swift Concurrency, Combine, Clean Architecture, MVVM, Dependency Injection, Modular Architecture, Objective-C, REST/JSON, Swift Package Manager, CocoaPods" },
  { cat: "State & Data", items: "SwiftData, Core Data, real-time data streaming, offline reliability, complex state management" },
  { cat: "AI & Agentic Systems", items: "Claude Code, MCP (Model Context Protocol), multi-agent orchestration, agentic pipeline design, LLM-assisted workflows, Core ML, on-device inference" },
  { cat: "Performance & Reliability", items: "Instruments, crash-free optimization, cold start reduction, Crashlytics, VoiceOver, Charles Proxy" },
  { cat: "DevOps & Quality", items: "CI/CD (Fastlane, Jenkins, Bitrise), TestFlight, Firebase, TDD, XCUITest, App Store Connect" },
  { cat: "Leadership", items: "Architectural decision-making, team management, mentoring, roadmap & strategy, cross-functional alignment, agile delivery" },
];

const roles = [
  {
    yr: "2024 — Present", co: "Freelance", title: "Lead iOS Engineer",
    body: "Built pragma, an 8-agent iOS development pipeline using Claude Code, automating the full feature lifecycle: spec, plan, feature, gates, review, test, bugfix, release. Human approval at 2 of 8 stages. Developed FinanceTracker, a production SwiftUI + SwiftData app, built entirely by the pipeline. Contributed a SwiftData testing skill to Swift-Agent-Skills (2,500+ stars), maintained by Paul Hudson.",
    now: true,
  },
  {
    yr: "2023 — 2024", co: "Medidata Solutions", title: "Senior iOS Application Engineer",
    body: "Senior technical point of contact for myMedidata, supporting 11M clinical trial participants and 1M monthly active users in a HIPAA-regulated environment. Led migration to Swift Concurrency and Combine, reducing background task latency by 25%. Sustained a 4.7★ App Store rating.",
  },
  {
    yr: "2021 — 2023", co: "Fiserv", title: "Lead Software Development Engineer",
    body: "Tech Lead for CardValet, a fintech app serving 5M users across 1,000+ financial institutions. Owned roadmap and delivery for a 10-engineer iOS team, improving on-time delivery from 60% to 88%. Reduced feature turnaround time by 40%. Designed CI/CD pipelines (Fastlane, Jenkins, Bitrise), cutting release prep time by 30%.",
  },
  {
    yr: "2019 — 2021", co: "Fiserv", title: "Software Development Engineering Analyst",
    body: "Led the technical redesign of CardValet, modernizing architecture while adding security and control features for millions of users. Introduced structured unit, integration, and XCUITest coverage to 70%, reducing regression bugs by 35%.",
  },
  {
    yr: "2018 — 2019", co: "Career Transition", title: "",
    body: "Evaluated iOS opportunities across fintech, healthcare, and consumer domains before joining Fiserv.",
  },
  {
    yr: "2016 — 2018", co: "WW International (Weight Watchers)", title: "iOS Engineer",
    body: "Delivered major UI/UX improvements and custom UI components to the WW app during a peak growth period (4.6M users, 4.8★ App Store rating), including HealthKit integration. Owned development and releases for shared platform CocoaPods.",
  },
  {
    yr: "2014 — 2016", co: "SapientNitro (Publicis Sapient)", title: "iOS Developer",
    body: "Architected scalable, feature-rich applications for major clients including Miami Heat, Ann Taylor/LOFT, and ADT, integrating Core Bluetooth.",
  },
  {
    yr: "2014", co: "Viacom", title: "iOS Developer",
    body: "Built the first version of Viacom's Paramount Network streaming app, featured as Best New App in Entertainment.",
  },
  {
    yr: "2014", co: "CVS Caremark", title: "iOS Developer",
    body: "Delivered the CVS Pharmacy app's ExtraCare feature, including data persistence for rewards and coupons.",
  },
  {
    yr: "2013 — 2014", co: "NYC Dept of IT and Telecom", title: "iOS Developer",
    body: "Built the official NYC 311 app for non-emergency services, improving community engagement by 35%.",
  },
  {
    yr: "2013", co: "Genworth Financial", title: "iOS Developer",
    body: "Built an enterprise iPad app, integrating Salesforce and SAP workflows.",
  },
  {
    yr: "2012 — 2013", co: "Vanguard", title: "iOS Developer",
    body: "Created the Markets Section of the Vanguard app, displaying real-time financial data.",
  },
];
---
<BaseLayout title="Career" description="12+ years of production iOS engineering across fintech, healthcare, and consumer." ogImage="/og/career.png">
  <section class="head">
    <h1 class="spring-in">Twelve years, one thread</h1>
    <p class="sub fade-in" style="animation-delay:.2s">
      Mobile engineering leadership across fintech, healthcare, and consumer — 1M to 20M users per app,
      HIPAA-regulated systems, and teams of 5 to 12 engineers. M.S. Computer Science, George Mason University
      (2010–2012) · B.E. Information Technology, Ramrao Adik Institute of Technology, University of Mumbai (2006–2010).
    </p>
  </section>

  <section class="skills fade-in" style="animation-delay:.3s">
    <h2 class="section-headline">Technical foundation</h2>
    <div class="skill-groups">
      {skillGroups.map((g) => (
        <div class="skill-row">
          <div class="cat">{g.cat}</div>
          <p class="items">{g.items}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="roles">
    {roles.map((r, i) => (
      <div class={`role glass-card fade-in ${r.now ? "now" : ""}`} style={`animation-delay:${0.4 + i * 0.05}s`}>
        <div class="yr">{r.yr}</div>
        <div class="body">
          <div class="co">{r.co}{r.title && <span class="title"> — {r.title}</span>}</div>
          <p>{r.body}</p>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .head, .skills, .roles{padding:0 6vw; max-width:920px; margin:0 auto;}
  .head{padding-top:9vh;}
  h1{font-size:clamp(32px,5vw,52px); font-weight:600; letter-spacing:-.02em; margin:14px 0 0;}
  .sub{font-size:15px; color:var(--dim); max-width:620px; margin:18px 0 0; line-height:1.6;}

  .skills{margin-top:6vh;}
  .section-headline{font-size:20px; font-weight:600; letter-spacing:-.01em; color:var(--ink); margin:0 0 18px;}
  .skill-groups{display:flex; flex-direction:column; gap:12px;}
  .skill-row{display:grid; grid-template-columns:170px 1fr; gap:22px; padding:6px 0;}
  .skill-row .cat{font-size:13px; color:var(--dim); font-weight:600; padding-top:1px;}
  .skill-row .items{margin:0; font-size:13px; color:var(--ink); line-height:1.65;}

  .roles{margin-top:7vh; padding-bottom:10vh; display:flex; flex-direction:column; gap:14px;
    border-left:1px solid var(--line);}
  .role{display:grid; grid-template-columns:120px 1fr; gap:22px; padding:20px 22px; margin-left:-1px; border-left:2px solid transparent;}
  .role.now{border-left-color:var(--accent);}
  .yr{font-size:11px; color:var(--dim); letter-spacing:.04em; font-variant-numeric:tabular-nums; padding-top:2px;}
  .co{font-size:16px; font-weight:600;}
  .co .title{font-weight:400; color:var(--dim);}
  .role p{margin:8px 0 0; font-size:13px; color:var(--dim); line-height:1.65; max-width:560px;}

  @media (max-width: 560px){
    .role{grid-template-columns:1fr; gap:6px;}
    .skill-row{grid-template-columns:1fr; gap:4px;}
  }
</style>
